{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "jsxImportSource": "solid-js", "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
