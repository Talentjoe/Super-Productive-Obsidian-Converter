{
  "name": "sp-obsidian-sync",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Safe bidirectional Obsidian vault synchronization for Super Productivity",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "npm run build && playwright test",
    "test:host:ui": "node tests/host/ui.mjs",
    "test:host:multi": "node tests/host/multi.mjs",
    "test:host:tags": "node tests/host/tags.mjs",
    "test:host": "node tests/host/smoke.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build",
    "docs": "node scripts/sync-guide.mjs",
    "git:setup": "node scripts/git-setup.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "marked": "^18.0.14",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.4"
  }
}
